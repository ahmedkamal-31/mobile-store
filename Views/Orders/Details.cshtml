@model MobileStore.Models.Order
@{ ViewData["Title"] = $"Order #{Model.Id}"; }
<div class="container py-5" style="max-width:700px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Order #@Model.Id</h2>
        <span class="badge @($"badge-{Model.Status.ToString().ToLower()}") fs-6">@Model.Status</span>
    </div>
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-sm-6"><div class="small text-muted">Order Date</div><div class="fw-bold">@Model.OrderDate.ToString("MMMM dd, yyyy")</div></div>
                <div class="col-sm-6"><div class="small text-muted">Total</div><div class="fw-bold text-primary fs-5">EGP @Model.TotalAmount.ToString("N0")</div></div>
                @if (!string.IsNullOrEmpty(Model.ShippingAddress))
                { <div class="col-sm-6"><div class="small text-muted">Address</div><div>@Model.ShippingAddress, @Model.City</div></div> }
                @if (!string.IsNullOrEmpty(Model.Phone))
                { <div class="col-sm-6"><div class="small text-muted">Phone</div><div>@Model.Phone</div></div> }
            </div>
        </div>
    </div>
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h5 class="fw-bold mb-3">Items</h5>
            @foreach (var item in Model.Items)
            {
                <div class="d-flex align-items-center gap-3 mb-3 pb-3 border-bottom">
                    <div class="bg-light rounded-3 d-flex align-items-center justify-content-center" style="width:60px;height:60px;">
                        @if (!string.IsNullOrEmpty(item.Phone?.ImageUrl))
                        { <img src="@item.Phone.ImageUrl" style="max-height:50px;object-fit:contain;" /> }
                        else { <span>📱</span> }
                    </div>
                    <div class="flex-grow-1">
                        <div class="fw-bold">@item.Phone?.Name</div>
                        @if (item.Phone?.Seller != null && !string.IsNullOrEmpty(item.Phone.Seller.ShopAddress))
                        { <div class="text-muted" style="font-size:11px;"><i class="bi bi-shop me-1"></i>@item.Phone.Seller.ShopAddress</div> }
                        <div class="text-muted small">× @item.Quantity at EGP @item.UnitPrice.ToString("N0") each</div>
                    </div>
                    <div class="fw-bold">EGP @item.Subtotal.ToString("N0")</div>
                </div>
            }
        </div>
    </div>
    @if (Model.Status == MobileStore.Models.OrderStatus.Pending || Model.Status == MobileStore.Models.OrderStatus.Confirmed)
    {
        <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Cancel this order?')">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-danger"><i class="bi bi-x-circle me-1"></i>Cancel Order</button>
        </form>
    }
</div>
