@model IEnumerable<MobileStore.Models.Order>
@{ ViewData["Title"] = "My Orders"; }
<div class="container py-5">
    <h2 class="fw-bold mb-4"><i class="bi bi-box-seam me-2"></i>My Orders</h2>
    @if (!Model.Any())
    {
        <div class="text-center py-5"><div style="font-size:3rem;">📦</div><h5 class="text-muted mt-2">No orders yet</h5>
        <a asp-controller="Phones" asp-action="Index" class="btn btn-primary mt-2">Start Shopping</a></div>
    }
    else
    {
        <div class="card border-0 shadow-sm overflow-hidden">
            <table class="table table-hover mb-0">
                <thead class="table-light"><tr><th>#</th><th>Date</th><th>Items</th><th>Total</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var o in Model)
                    {
                        <tr>
                            <td class="fw-bold">#@o.Id</td>
                            <td class="small text-muted">@o.OrderDate.ToString("MMM dd, yyyy")</td>
                            <td class="small">@o.Items.Count item(s)</td>
                            <td class="fw-bold">EGP @o.TotalAmount.ToString("N0")</td>
                            <td><span class="badge @($"badge-{o.Status.ToString().ToLower()}")">@o.Status</span></td>
                            <td><a asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-primary">View</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
