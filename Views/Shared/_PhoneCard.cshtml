@model MobileStore.Models.Phone
@{
    decimal disc = Model.OldPrice.HasValue && Model.OldPrice > 0
        ? Math.Round((1 - Model.Price / Model.OldPrice.Value) * 100) : 0;
}
<div class="col-6 col-md-4 col-lg-3">
    <div class="card h-100 border-0 shadow-sm phone-card">
        <div class="position-relative bg-light d-flex align-items-center justify-content-center" style="height:180px;overflow:hidden;">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            { <img src="@Model.ImageUrl" alt="@Model.Name" style="max-height:160px;object-fit:contain;" /> }
            else
            { <span style="font-size:4rem;">📱</span> }
            @if (disc > 0)
            { <span class="badge bg-danger position-absolute top-0 end-0 m-2">-@disc%</span> }
        </div>
        <div class="card-body p-3">
            <span class="badge bg-primary bg-opacity-10 text-primary mb-1" style="font-size:11px;">@Model.Brand?.Name</span>
            <p class="fw-bold mb-1" style="font-size:14px;line-height:1.3;">@Model.Name</p>
            <div class="d-flex gap-1 flex-wrap mb-2">
                <span class="badge bg-light text-muted border" style="font-size:11px;">@Model.RAM GB RAM</span>
                <span class="badge bg-light text-muted border" style="font-size:11px;">@Model.Storage GB</span>
                @if (!string.IsNullOrEmpty(Model.Network))
                { <span class="badge bg-light text-muted border" style="font-size:11px;">@Model.Network</span> }
                <span class="badge bg-info bg-opacity-10 text-info border-info border" style="font-size:11px;">@Model.Condition</span>
            </div>
            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="fw-bold text-primary">EGP @Model.Price.ToString("N0")</span>
                @if (Model.OldPrice.HasValue)
                { <small class="text-muted text-decoration-line-through">@Model.OldPrice.Value.ToString("N0")</small> }
            </div>
            @if (Model.Stock == 0)
            {
                <span class="badge bg-danger w-100 mb-2">Out of Stock</span>
            }
            @if (Model.Seller != null && !string.IsNullOrEmpty(Model.Seller.ShopAddress))
            {
                <div class="small text-muted mb-2"><i class="bi bi-shop me-1"></i>@Model.Seller.ShopAddress</div>
            }
            <div class="d-flex gap-2">
                <a asp-controller="Phones" asp-action="Details" asp-route-id="@Model.Slug"
                   class="btn btn-primary btn-sm flex-grow-1">View</a>
                <a asp-controller="Phones" asp-action="Compare" asp-route-a="@Model.Id"
                   class="btn btn-outline-secondary btn-sm" title="Compare"><i class="bi bi-bar-chart-steps"></i></a>
            </div>
        </div>
    </div>
</div>
