@using MobileStore.Models
@model PhoneFormViewModel
<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Name" class="form-label">Phone Name *</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="BrandId" class="form-label">Brand *</label>
        <select asp-for="BrandId" class="form-select" asp-items="@(new SelectList(Model.Brands,"Id","Name"))">
            <option value="">Select brand</option>
        </select>
    </div>
    <div class="col-md-4">
        <label asp-for="Price" class="form-label">Price (EGP) *</label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" />
    </div>
    <div class="col-md-4">
        <label asp-for="OldPrice" class="form-label">Old Price (optional)</label>
        <input asp-for="OldPrice" class="form-control" type="number" step="0.01" />
    </div>
    <div class="col-md-4">
        <label asp-for="Condition" class="form-label">Condition *</label>
        <select asp-for="Condition" class="form-select" asp-items="Html.GetEnumSelectList<PhoneCondition>()">
            <option value="">Select condition</option>
        </select>
        <span asp-validation-for="Condition" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Stock" class="form-label">Stock</label>
        <input asp-for="Stock" class="form-control" type="number" />
    </div>
    <div class="col-md-3"><label asp-for="RAM" class="form-label">RAM (GB)</label><input asp-for="RAM" class="form-control" type="number" /></div>
    <div class="col-md-3"><label asp-for="Storage" class="form-label">Storage (GB)</label><input asp-for="Storage" class="form-control" type="number" /></div>
    <div class="col-md-3"><label asp-for="ScreenSize" class="form-label">Screen (inches)</label><input asp-for="ScreenSize" class="form-control" type="number" step="0.01" /></div>
    <div class="col-md-3"><label asp-for="Battery" class="form-label">Battery (mAh)</label><input asp-for="Battery" class="form-control" type="number" /></div>
    <div class="col-md-6"><label asp-for="Processor" class="form-label">Processor</label><input asp-for="Processor" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="Camera" class="form-label">Camera</label><input asp-for="Camera" class="form-control" /></div>
    <div class="col-md-4"><label asp-for="OS" class="form-label">OS</label><input asp-for="OS" class="form-control" /></div>
    <div class="col-md-4"><label asp-for="Network" class="form-label">Network</label><input asp-for="Network" class="form-control" /></div>
    <div class="col-md-4"><label asp-for="Color" class="form-label">Color</label><input asp-for="Color" class="form-control" /></div>
    <div class="col-12"><label asp-for="ImageUrl" class="form-label">Image URL</label><input asp-for="ImageUrl" class="form-control" /></div>
    <div class="col-12"><label asp-for="Description" class="form-label">Description</label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>
    <div class="col-md-6">
        <div class="form-check mt-2">
            <input asp-for="IsAvailable" class="form-check-input" />
            <label asp-for="IsAvailable" class="form-check-label">Available in Store</label>
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-check mt-2">
            <input asp-for="IsFeatured" class="form-check-input" />
            <label asp-for="IsFeatured" class="form-check-label">Featured on Homepage</label>
        </div>
    </div>
</div>
