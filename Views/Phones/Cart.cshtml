@model CartViewModel
@{ ViewData["Title"] = "My Cart"; }
<div class="container py-5">
    <h2 class="fw-bold mb-4"><i class="bi bi-bag me-2"></i>My Cart</h2>
    @if (!Model.Items.Any())
    {
        <div class="text-center py-5"><div style="font-size:4rem;">🛒</div><h5 class="text-muted mt-2">Your cart is empty</h5>
        <a asp-controller="Phones" asp-action="Index" class="btn btn-primary mt-2">Browse Phones</a></div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                @foreach (var item in Model.Items)
                {
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-body d-flex gap-3 align-items-center">
                            <div class="bg-light rounded-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width:80px;height:80px;">
                                @if (!string.IsNullOrEmpty(item.Phone.ImageUrl))
                                { <img src="@item.Phone.ImageUrl" style="max-height:70px;object-fit:contain;" /> }
                                else { <span style="font-size:2rem;">📱</span> }
                            </div>
                            <div class="flex-grow-1">
                                <div class="small text-primary fw-bold">@item.Phone.Brand?.Name</div>
                                <div class="fw-bold">@item.Phone.Name</div>
                                <div class="text-muted small">@item.Phone.RAM GB / @item.Phone.Storage GB</div>
                            </div>
                            <div class="text-center">
                                <div class="fw-bold text-primary">EGP @item.Phone.Price.ToString("N0")</div>
                                <form asp-action="UpdateCartItem" method="post" class="d-flex align-items-center gap-1 mt-1 justify-content-center">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="cartItemId" value="@item.Id" />
                                    <button type="submit" name="quantity" value="@(item.Quantity - 1)" class="btn btn-sm btn-outline-secondary px-2" @(item.Quantity <= 1 ? "disabled" : "")>-</button>
                                    <span class="fw-bold mx-1">@item.Quantity</span>
                                    <button type="submit" name="quantity" value="@(item.Quantity + 1)" class="btn btn-sm btn-outline-secondary px-2" @(item.Quantity >= item.Phone.Stock ? "disabled" : "")>+</button>
                                </form>
                            </div>
                            <div class="fw-bold" style="min-width:90px;text-align:right;">EGP @((item.Phone.Price*item.Quantity).ToString("N0"))</div>
                            <form asp-action="RemoveFromCart" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                <button class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    </div>
                }
            </div>
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">Order Summary</h5>
                        <div class="d-flex justify-content-between mb-2"><span>Items (@Model.ItemCount)</span><span>EGP @Model.Total.ToString("N0")</span></div>
                        <div class="d-flex justify-content-between mb-2"><span>Shipping</span><span class="text-success">Free</span></div>
                        <hr/>
                        <div class="d-flex justify-content-between fw-bold fs-5 mb-3"><span>Total</span><span class="text-primary">EGP @Model.Total.ToString("N0")</span></div>
                        @if (!User.IsInRole("Seller"))
                        {
                            <a asp-action="Checkout" class="btn btn-primary w-100 btn-lg">Checkout <i class="bi bi-arrow-right ms-1"></i></a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
