@model RecommendationViewModel
@{ ViewData["Title"] = $"Similar to {Model.BasePhone.Name}"; }
<div class="container py-5">
    <div class="alert alert-light border mb-4 d-flex align-items-center gap-3">
        <span style="font-size:2rem;">🤖</span>
        <div>
            <h5 class="fw-bold mb-1">Phones similar to <strong>@Model.BasePhone.Name</strong></h5>
            <p class="mb-0 text-muted small">Based on brand, price range, specs, and network.</p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.BasePhone.Slug" class="btn btn-sm btn-outline-primary ms-auto">Back to phone</a>
    </div>
    <div class="row g-3">
        @foreach (var p in Model.Recommended) { @await Html.PartialAsync("_PhoneCard", p) }
    </div>
</div>
