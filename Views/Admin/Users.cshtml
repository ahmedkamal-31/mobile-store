@model IEnumerable<MobileStore.Models.ApplicationUser>
@{ ViewData["Title"] = "Users"; }
<div class="container-fluid py-4 px-4">
    <h2 class="fw-bold mb-4">Users (@Model.Count())</h2>
    <div class="card border-0 shadow-sm">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Joined</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="fw-bold small">@u.FullName</td>
                        <td class="small text-muted">@u.Email</td>
                        <td class="small">@(u.IsSeller ? "Seller" : "Customer")</td>
                        <td class="small text-muted">@u.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td>
                            @if (u.IsBlocked)
                            {
                                <span class="badge bg-danger">Blocked</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </td>
                        <td>
                            @if (u.IsBlocked)
                            {
                                <form asp-action="UnblockUser" method="post" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <button class="btn btn-sm btn-outline-success">Unblock</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="BlockUser" method="post" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <button class="btn btn-sm btn-outline-danger">Block</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
