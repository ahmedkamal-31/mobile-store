@model IEnumerable<MobileStore.Models.ApplicationUser>
@{ ViewData["Title"] = "Manage Sellers"; }

<div class="container-fluid py-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0"><i class="bi bi-people me-2"></i>Manage Sellers</h2>
    </div>

    <form method="get" class="mb-4">
        <div class="input-group" style="max-width:400px;">
            <input name="q" type="search" class="form-control" placeholder="Search by name, email, phone, or shop…" value="@Context.Request.Query["q"]" />
            <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i></button>
            @if (!string.IsNullOrEmpty(Context.Request.Query["q"]))
            {
                <a asp-action="Sellers" class="btn btn-outline-secondary">Clear</a>
            }
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm"><div class="card-body text-center py-5 text-muted">No sellers found.</div></div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Shop Address</th>
                        <th>Joined</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="fw-bold small">@s.FullName</td>
                            <td class="small text-muted">@s.Email</td>
                            <td class="small">@(s.PhoneNumber ?? "-")</td>
                            <td class="small text-muted">@(s.ShopAddress ?? "-")</td>
                            <td class="small text-muted">@s.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                @if (s.IsBlocked)
                                {
                                    <span class="badge bg-danger">Blocked</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap">
                                    @if (s.IsBlocked)
                                    {
                                        <form asp-action="UnblockUser" method="post" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@s.Id" />
                                            <button class="btn btn-sm btn-outline-success">Unblock</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="BlockUser" method="post" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@s.Id" />
                                            <button class="btn btn-sm btn-outline-danger">Block</button>
                                        </form>
                                    }
                                    <a asp-action="SellerProducts" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Products</a>
                                    <a asp-action="SellerOrders" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">Orders</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
