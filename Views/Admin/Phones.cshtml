@model IEnumerable<MobileStore.Models.Phone>
@{ ViewData["Title"] = "Manage Phones"; }
<div class="container-fluid py-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Manage Phones</h2>
        <span class="text-muted small">View and manage all phones in the store</span>
    </div>
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <form method="get" class="d-flex gap-2">
                <input name="q" class="form-control" style="max-width:280px;" placeholder="Search phones…" value="@ViewBag.Query" />
                <button class="btn btn-outline-primary">Search</button>
            </form>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light"><tr><th>Phone</th><th>Brand</th><th>Price</th><th>Stock</th><th>Status</th><th>Seller</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td><div class="fw-bold small">@p.Name</div><div class="text-muted" style="font-size:11px;">@p.RAM GB / @p.Storage GB / @p.Network</div></td>
                            <td class="small">@p.Brand?.Name</td>
                            <td class="fw-bold small">EGP @p.Price.ToString("N0")</td>
                            <td class="@(p.Stock<=5?"text-danger fw-bold":"") small">@p.Stock</td>
                            <td><span class="badge @(p.IsAvailable?"bg-success":"bg-secondary")">@(p.IsAvailable?"Active":"Hidden")</span></td>
                            <td class="small text-muted">@(p.Seller?.ShopAddress ?? "-")</td>
                            <td>
                                <a asp-controller="Phones" asp-action="Details" asp-route-id="@p.Slug" class="btn btn-sm btn-outline-secondary me-1" title="View"><i class="bi bi-eye"></i></a>
                                <form asp-action="ToggleVisibility" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('@(p.IsAvailable ? "Hide" : "Unhide") this phone?')">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm @(p.IsAvailable ? "btn-outline-warning" : "btn-outline-success")" title="@(p.IsAvailable ? "Hide" : "Unhide")">
                                        <i class="bi @(p.IsAvailable ? "bi-eye-slash" : "bi-eye")"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
