@model LoginViewModel
@{ ViewData["Title"] = "Login"; }
<div class="container py-5" style="max-width:420px;">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <h3 class="fw-bold text-center mb-1">Welcome back</h3>
            <p class="text-muted text-center small mb-4">Log in to your account</p>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label small">Remember me</label>
                </div>
                <button class="btn btn-primary w-100 btn-lg">Login</button>
            </form>
            <hr/>
            <p class="text-center small mb-0">Don't have an account? <a asp-action="Register">Sign up</a></p>
        </div>
    </div>
</div>
