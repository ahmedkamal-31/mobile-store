@model MobileStore.Models.ApplicationUser
@{ ViewData["Title"] = "My Profile"; }
<div class="container py-5" style="max-width:500px;">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 text-center">
            <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle bg-primary text-white fw-bold" style="width:70px;height:70px;font-size:2rem;">
                @Model.FullName[0]
            </div>
            <h4 class="fw-bold">@Model.FullName</h4>
            <p class="text-muted">@Model.Email</p>
            @if (!string.IsNullOrEmpty(Model.ShopAddress))
            { <p class="small mb-0"><i class="bi bi-shop me-1"></i>@Model.ShopAddress</p> }
            <hr/>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-box-seam me-1"></i>My Orders</a>
                <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary disabled"><i class="bi bi-person me-1"></i>Profile</a>
            </div>
        </div>
    </div>
</div>
