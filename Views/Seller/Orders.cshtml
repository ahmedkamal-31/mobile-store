@model IEnumerable<SellerOrderViewModel>
@{ ViewData["Title"] = "My Orders"; }
<div class="container-fluid py-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0"><i class="bi bi-box-seam me-2"></i>My Orders</h2>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Dashboard</a>
    </div>
    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <div style="font-size:3rem;">📦</div>
                <h5 class="text-muted mt-2">No orders yet</h5>
                <p class="text-muted small">When a customer orders your products, they will appear here.</p>
            </div>
        </div>
    }
    else
    {
        foreach (var order in Model)
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <div>
                        <strong class="fs-6">Order #@order.OrderId</strong>
                        <span class="ms-2 badge @($"badge-{order.Status.ToString().ToLower()}")">@order.Status</span>
                    </div>
                    <small class="text-muted">@order.OrderDate.ToString("MMM dd, yyyy h:mm tt")</small>
                </div>
                <div class="card-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <h6 class="fw-bold text-primary mb-2"><i class="bi bi-person me-1"></i>Customer</h6>
                            <div class="small"><strong>Name:</strong> @order.CustomerName</div>
                            <div class="small"><strong>Email:</strong> @order.CustomerEmail</div>
                            <div class="small"><strong>Phone:</strong> @(order.CustomerPhone ?? "-")</div>
                            <div class="small"><strong>Address:</strong> @(order.CustomerAddress ?? "-")</div>
                        </div>
                        <div class="col-md-6">
                            <h6 class="fw-bold text-success mb-2"><i class="bi bi-shop me-1"></i>Your Items</h6>
                            <table class="table table-sm mb-0">
                                <thead class="table-light">
                                    <tr><th>Product</th><th>Qty</th><th>Unit Price</th><th>Subtotal</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in order.Items)
                                    {
                                        <tr>
                                            <td class="fw-bold small">@item.PhoneName</td>
                                            <td class="small">@item.Quantity</td>
                                            <td class="small">EGP @item.UnitPrice.ToString("N0")</td>
                                            <td class="small fw-bold">EGP @item.Subtotal.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="fw-bold">
                                        <td colspan="3" class="text-end">Order Total:</td>
                                        <td>EGP @order.TotalAmount.ToString("N0")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <hr />
                    <h6 class="fw-bold mb-2">Update Status</h6>
                    <form asp-action="UpdateOrderStatus" method="post" class="d-flex gap-2 align-items-center">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@order.OrderId" />
                        <select name="status" class="form-select form-select-sm" style="width:auto;">
                            @foreach (MobileStore.Models.OrderStatus s in Enum.GetValues(typeof(MobileStore.Models.OrderStatus)))
                            {
                                if (order.Status == s)
                                {
                                    <option value="@s" selected>@s</option>
                                }
                                else
                                {
                                    <option value="@s">@s</option>
                                }
                            }
                        </select>
                        <button class="btn btn-sm btn-primary">Update</button>
                    </form>
                </div>
            </div>
        }
    }
</div>
